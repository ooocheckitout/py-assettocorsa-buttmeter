{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "venv",
      "type": "shell",
      "command": "python -m venv .venv; .venv/Scripts/activate; pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "install",
      "type": "shell",
      "command": "Copy-Item apps, content $env:AC_DIR -Recurse -Force",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        },
        "env": {
          "AC_DIR": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\assettocorsa"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "zip",
      "type": "shell",
      "command": "git archive -o WheelLock.zip HEAD apps content",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "problemMatcher": []
    }
  ]
}
